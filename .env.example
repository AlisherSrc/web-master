# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored — NEVER commit real credentials.
# -----------------------------------------------------------------------------

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=celestial
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=celestial_db

# --- Backend ------------------------------------------------------------------
# Host port where the web UI / API will be available (http://localhost:APP_PORT)
APP_PORT=8000

# Classifier mode:
#   auto   -> use Gemini if GEMINI_API_KEY is set, otherwise fall back to mock
#   gemini -> always use Gemini (requests fail with 503 if no key is configured)
#   mock   -> deterministic fake classifier, no internet/API key needed
CLASSIFIER_MODE=auto

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Maximum accepted image size in megabytes
MAX_UPLOAD_MB=5

# debug | info | warning | error
LOG_LEVEL=info
